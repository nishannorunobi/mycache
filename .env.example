# ── Redis version ──────────────────────────────────────────────────────────────
REDIS_VERSION=7-alpine

# ── Network ────────────────────────────────────────────────────────────────────
REDIS_HOST=0.0.0.0
REDIS_PORT=6379

# ── Auth ───────────────────────────────────────────────────────────────────────
# REDIS_PASSWORD is NOT in this file — it lives in kms: kv/mycache/redis
#   start.sh fetches it at every start (connect_external/kms/). See / change it:
#   kms UI http://127.0.0.1:8110/ui → kv → mycache → redis   ·   details: README.md "Where are the secrets?"
