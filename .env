# ── Redis version ──────────────────────────────────────────────────────────────
REDIS_VERSION=7-alpine

# ── Network ────────────────────────────────────────────────────────────────────
REDIS_HOST=0.0.0.0
REDIS_PORT=6379

# ── Clock ──────────────────────────────────────────────────────────────────────
TZ=America/New_York

# No secret here: the Redis password lives in kms — its address is in cache-agent/agent.conf
# (the cache-agent fetches it and starts Redis). See README.md "Where are the secrets?".
