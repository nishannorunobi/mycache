# ── Redis version ──────────────────────────────────────────────────────────────
REDIS_VERSION=7-alpine

# ── Network ────────────────────────────────────────────────────────────────────
REDIS_HOST=0.0.0.0
REDIS_PORT=6379

# ── Auth ───────────────────────────────────────────────────────────────────────
# A secret's value is its kms address — the container fetches the real value at start.
# kms on another machine: https://<kms-host>:<port>/v1/kv/data/mycache/redis
REDIS_PASSWORD=http://kms-openbao:8200/v1/kv/data/mycache/redis

# ── Clock ──────────────────────────────────────────────────────────────────────
TZ=America/New_York
