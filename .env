# ── Redis version ──────────────────────────────────────────────────────────────
REDIS_VERSION=7-alpine

# ── Network ────────────────────────────────────────────────────────────────────
REDIS_HOST=0.0.0.0
REDIS_PORT=6379

# ── kms (where the secrets live) — mycache may run on another machine than kms ──
# Reached over the network only. Both are plain settings, not secrets.
KMS_URL=http://127.0.0.1:8110                 # kms on another machine: https://<kms-host>:<port>
KMS_APPROLE_DIR=                              # empty = connect_external/kms/credentials
                                              # (written by connect_external/kms/signup_with_kms.sh)

# ── Auth ───────────────────────────────────────────────────────────────────────
# REDIS_PASSWORD is NOT in this file — it lives in kms: kv/mycache/redis
#   start.sh fetches it at every start (connect_external/kms/). See / change it:
#   kms UI http://127.0.0.1:8110/ui → kv → mycache → redis   ·   details: README.md "Where are the secrets?"
